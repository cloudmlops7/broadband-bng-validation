[modules]
log_file
pppoe
auth_pap
auth_chap_md5
#chap-secrets
radius
ippool
shaper

[core]
log-error=/var/log/accel-ppp/core.log
thread-count=2

[common]
single-session=replace

[log]
log-file=/var/log/accel-ppp/accel-ppp.log
level=5
copy=1

[cli]
tcp=0.0.0.0:2001

[pppoe]
verbose=1
interface=eth1.900.900

[ip-pool]
gw-ip-address=10.10.10.1
10.10.10.10-10.10.10.100

[radius]
server=172.30.0.3,CHANGE_ME
verbose=1

[shaper]
verbose=1

[chap-secrets]
chap-secrets=/etc/accel-ppp/chap-secrets
